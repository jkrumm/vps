# MariaDB TLS cert sync from traefik/acme.json — every 6 hours at :17
# Detects renewals (Traefik renews ~30 days before expiry) and FLUSH SSL into the running container.
# Install: cp cron/fpp-cert-sync /etc/cron.d/fpp-cert-sync && chmod 644 /etc/cron.d/fpp-cert-sync
#
# Cron runs with an empty environment, so OP_SERVICE_ACCOUNT_TOKEN is loaded from
# /etc/vps/op.env (0600 jkrumm, created by scripts/setup.sh) — otherwise `op run`
# fails with "No accounts configured for use with 1Password CLI". The fallback to
# ~/.bashrc only covers the window before that file exists: Ubuntu's stock .bashrc
# returns early when non-interactive, so it works only if the token sits above that guard.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

17 */6 * * * jkrumm /bin/bash -c 'if [ -r /etc/vps/op.env ]; then set -a; . /etc/vps/op.env; set +a; else . /home/jkrumm/.bashrc; fi; cd /home/jkrumm/vps && op run --env-file=.env.tpl -- /home/jkrumm/vps/apps/fpp/scripts/cert-sync.sh' >> /home/jkrumm/fpp-cert-sync.log 2>&1
