    },
    {
      "config": {
        "configType": "sql",
        "connection": "Local ClickHouse",
        "displayType": "table",
        "source": "Traces",
        "sqlTemplate": "SELECT SpanAttributes['ci.runner'] AS Runner, countIf(SpanAttributes['ci.kind'] = 'job') AS Jobs, round(sumIf(Duration, SpanAttributes['ci.kind'] = 'job') / 1e9 / 3600, 2) AS `Busy hours`, round(quantileIf(0.5)(Duration, SpanAttributes['ci.kind'] = 'queue') / 1e9) AS `Queue p50 (s)`, round(quantileIf(0.95)(Duration, SpanAttributes['ci.kind'] = 'queue') / 1e9) AS `Queue p95 (s)`, round(maxIf(Duration, SpanAttributes['ci.kind'] = 'queue') / 1e9) AS `Queue max (s)` FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'ci-poller' AND $__filters GROUP BY Runner ORDER BY Jobs DESC LIMIT 30"
      },
