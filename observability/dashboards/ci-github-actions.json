    {
      "config": {
        "configType": "sql",
        "connection": "Local ClickHouse",
        "displayType": "table",
        "source": "Traces",
        "sqlTemplate": "SELECT SpanAttributes['vcs.repository.name'] AS Repo, countIf(SpanAttributes['ci.kind'] = 'run') AS Runs, countIf(SpanAttributes['ci.kind'] = 'run' AND SpanAttributes['cicd.pipeline.result'] = 'failure') AS Failed, round(quantileIf(0.5)(Duration, SpanAttributes['ci.kind'] = 'run') / 1e9) AS `Run p50 (s)`, round(quantileIf(0.95)(Duration, SpanAttributes['ci.kind'] = 'run') / 1e9) AS `Run p95 (s)`, round(quantileIf(0.95)(Duration, SpanAttributes['ci.kind'] = 'queue') / 1e9) AS `Queue p95 (s)`, round(sumIf(Duration, SpanAttributes['ci.kind'] = 'job') / 1e9 / 60) AS `Job minutes`, countIf(SpanAttributes['ci.kind'] = 'job' AND SpanAttributes['ci.runner.kind'] = 'self-hosted') AS `Jobs on VPS` FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'ci-poller' AND $__filters GROUP BY Repo ORDER BY Runs DESC LIMIT 100"
      },
      "containerId": "tables",
      "h": 9,
      "id": "6afcd99bc162ceda14bdc111",
      "name": "Per repo",
