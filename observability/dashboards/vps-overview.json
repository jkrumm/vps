        "source": "Traces",
        "sqlTemplate": "SELECT SpanAttributes['server.address'] AS Host, count() AS Requests, countIf(StatusCode = 'Error') AS `5xx`, round(quantile(0.95)(Duration) / 1e6) AS `p95 (ms)` FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'traefik' AND SpanKind = 'Server' AND SpanAttributes['server.address'] != 'otel.jkrumm.com' AND SpanAttributes['url.scheme'] != 'wss' AND $__filters GROUP BY Host ORDER BY Requests DESC LIMIT 20"
