# TLS certificates — never commit
traefik/acme.json

# Local env overrides / materialized secrets — never commit.
# Broad match with an explicit allow for the op:// templates, which are safe.
.env
.env.*
*.env
!*.env.tpl
!.env.tpl
# `.env.*` above also swallows .env.dev.tpl, and neither negation covers it
# (`!*.env.tpl` needs a char before `.env`, `!.env.tpl` is an exact name). It is
# op:// references only, same as .env.tpl, and must be tracked — the dev stack
# does not start without it.
!.env.dev.tpl

# OS
.DS_Store

# Editor
.idea/
.vscode/

# Doppler local config
.doppler.yaml

# Repo-contract state — last deployed SHA + affected app list (Makefile `deploy`)
.deploy-sha
.deploy-apps
